# Any OpenAI-compatible endpoint works (Groq, OpenAI, Ollama at http://localhost:11434/v1, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
LLM_MODEL=llama-3.1-8b-instant
# Prices per 1M tokens - set from your provider's pricing page (used for cost tracking)
PRICE_IN_PER_1M=0.05
PRICE_OUT_PER_1M=0.08
APP_API_KEY=change-me
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
MIN_SCORE=0.25
